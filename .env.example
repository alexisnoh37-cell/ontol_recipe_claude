# 복사해서 .env로 저장한다(Windows: copy .env.example .env). .env는 git에 올리지 않는다.
# 로컬 PostgreSQL이 이미 5432를 쓰고 있으면 POSTGRES_PORT와 아래 URL의 포트를 함께 바꾼다(예: 5433).
POSTGRES_USER=recipe
POSTGRES_PASSWORD=recipe
POSTGRES_DB=recipe
POSTGRES_PORT=5432

# 앱·스크립트·Alembic이 쓰는 DB
DATABASE_URL=postgresql+psycopg://recipe:recipe@localhost:5432/recipe
# tests/storage/ 전용 DB(테스트가 테이블을 지우고 다시 만든다). 비워 두면 DB 테스트는 skip
TEST_DATABASE_URL=postgresql+psycopg://recipe:recipe@localhost:5432/recipe_test

# Jev(TypeSafe AI) API 키(docs/plan.md 부록 F·G). 추천 v2의 재정렬과 라벨링이 쓴다. 비워 두면 v2는 규칙 순위로만 동작
# (예전 이름 JEV_API_KEY도 읽는다). 출력·커밋 금지
TYPESAFE_API_KEY=
